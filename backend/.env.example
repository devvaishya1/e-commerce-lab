# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Credentials
# Option 1: Full Connection String
# DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/genz_fits

# Option 2: Individual Parameters
PGUSER=postgres
PGPASSWORD=YOUR_POSTGRES_PASSWORD
PGHOST=localhost
PGPORT=5432
PGDATABASE=genz_fits

# Fallback Configuration
# When set to true, allows server to respond with fallback seed catalog if PostgreSQL is not active locally,
# enabling seamless UI/API preview and lab evaluation. Set to false to enforce strict PostgreSQL-only mode.
USE_FALLBACK_ON_DB_ERROR=true
